# ============================================================
# HelpTI — proteção do webroot (Apache / cPanel)
# ============================================================

Options -Indexes

# ── Bloqueia acesso direto a fontes, dumps, configs e scripts internos ──
<FilesMatch "\.(bak|sql|json|csv|md|example|dist|log|sh|py|pyc|lock|ini|yml|yaml|lock|old|orig|save|swp)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|config\.local|db|gemini|estoque_helpers|impressoras_helpers|sync_inventario|lib_cron)\.php$">
    Require all denied
</FilesMatch>

# scan_ultimo.json, scan_rede_*.csv, *.bak — reforço explícito
<FilesMatch "^(scan_ultimo\.json|scan_rede_.*\.csv|.*\.php\.bak)$">
    Require all denied
</FilesMatch>

# ── Diretórios que nunca devem ser servidos ──
RedirectMatch 404 (?i)/(database|bin|logs|src|_local_arquivado|_backups|\.git)(/|$)

# ── Cabeçalhos de segurança ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"
    # CSP: restringe destinos de script/estilo/imagem/conexão.
    # 'unsafe-inline' ainda é necessário (o sistema usa <script>/style= inline);
    # o ganho real é limitar exfiltração e carregamento externo a hosts conhecidos.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── HSTS só faz sentido sob HTTPS ──
<IfModule mod_headers.c>
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=15552000"
    </If>
</IfModule>

# ── PHP: não expor versão, sessão endurecida (redundante com db.php, cinto e suspensório) ──
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite "Lax"
</IfModule>
